{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--host"],
      "port": 5173
    },
    {
      "name": "frontend-mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev:mock", "--", "--host"],
      "port": 5173
    },
    {
      "name": "backend-dev",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "PYTHONPATH=backend python3 -m uvicorn app.main:app --reload --port 8000"],
      "port": 8000
    }
  ]
}
